PORT=5002

# Database Configuration
DATABASE_URL=postgresql://job_finder_user:secure_password_123@db:5432/job_finder

# JWT Token Secrets (generate strong random values for production)
ACCESS_TOKEN_SECRET=<32-char random string>
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=<32-char random string>
REFRESH_TOKEN_EXPIRES_IN=7d

# Redis / Message Queue
GO_ENV=development
REDIS_URL="redis://job-finder-redis-go:6379"
QUEUE_CONCURRENCY=5
CORS_ORIGIN=http://localhost:3000
