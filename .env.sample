PORT=5002
GO_ENV="development"

# Database Configuration
DB_HOST="job-finder-db-go"
DB_USER="job_finder_user"
DB_PASS="secure_password_123"
DB_NAME="job_finder"
DATABASE_URL="postgresql://job_finder_user:secure_password_123@job-finder-db-go:5432/job_finder?sslmode=disable"

PGADMIN_DEFAULT_EMAIL="admin@admin.com"
PGADMIN_DEFAULT_PASSWORD="admin"

# JWT Token Secrets (generate strong random values for production)
ACCESS_TOKEN_SECRET=<32-char random string>
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET=<32-char random string>
REFRESH_TOKEN_EXPIRES_IN="7d"

# Redis / Message Queue
REDIS_URL="redis://job-finder-redis-go:6379"
QUEUE_CONCURRENCY=5

# CORS
CORS_ORIGIN="http://localhost:3000"
